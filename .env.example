# Copia estas variables al entorno del servidor (este archivo no se carga solo).
# Genera una clave nueva para cada despliegue: python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA_UNICA
DJANGO_ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# Activa estas opciones solo cuando HTTPS ya esté funcionando en el servidor.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
# Solo si un proxy confiable administra HTTPS y sobrescribe X-Forwarded-Proto.
DJANGO_TRUST_PROXY_SSL_HEADER=False
# Empieza en 0; sube a 31536000 (un año) solo tras confirmar HTTPS en todo el dominio.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

DB_NAME=ClinicaDrScholl
DB_HOST=servidor-sql
DB_PORT=1433
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_USER=usuario_de_aplicacion
DB_PASSWORD=REEMPLAZAR_POR_UNA_CREDENCIAL_SEGURA
DB_TRUSTED_CONNECTION=no
DB_EXTRA_PARAMS=Encrypt=yes;TrustServerCertificate=no

LOGIN_THROTTLE_MAX_ATTEMPTS=5
LOGIN_THROTTLE_MAX_IP_ATTEMPTS=30
LOGIN_THROTTLE_WINDOW_SECONDS=900
